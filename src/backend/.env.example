# Copy to backend/.env and adjust. Names follow docs/api-contract.md section 2.

# --- models ---
LLM_MODEL=qwen2.5:3b
OLLAMA_URL=http://localhost:11434/api/chat
EMBED_MODEL=BAAI/bge-small-en-v1.5
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_SECONDS=300

# --- retrieval ---
# ChromaDB server (Docker). Leave CHROMA_HOST empty to use the local DB_DIR folder instead.
DB_DIR=vectordb
COLLECTION_NAME=srr_bge_small_cls_v2
TOP_K=5
SIM_THRESHOLD=0.55
KEEP_MARGIN=0.10
HISTORY_TURNS=2

# --- app ---
SESSIONS_DB=backend/sessions.db
CORS_ORIGINS=http://localhost:5173
MAX_QUESTION_LENGTH=1000

# true = fake answers with no models loaded (for frontend development)
USE_MOCK_RAG=false

USE_MOCK_RAG=
CHROMA_HOST=
CHROMA_PORT=
CHROMA_SSL=