    "original_speaker": "SPEAKER_00",
    "verified_speaker": "Translator",
    "text": "Something like that.",
    "include_in_corpus": null,
    "exclusion_reason": null
  },
  {
    "segment_id": "SRR_001_87",
    "start": 798.245,
    "end": 809.112,
    "original_speaker": "SPEAKER_00",
    "verified_speaker": "Translator",
    "text": "May this delightful sacred offering cloud of essential pit instructions cause you to gain realization of the definitive secret that is like space.",
