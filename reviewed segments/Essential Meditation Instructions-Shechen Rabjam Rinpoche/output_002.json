    "start": 876.779,
    "end": 887.214,
    "original_speaker": "SPEAKER_01",
    "verified_speaker": "Rinpochoe",
    "text": "what you call, actualize, recognize or not, that's up to my teacher to decide.",
    "include_in_corpus": null,
    "exclusion_reason": null
  },
