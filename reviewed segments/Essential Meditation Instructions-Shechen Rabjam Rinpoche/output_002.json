    "include_in_corpus": null,
    "exclusion_reason": null
  },
  {
    "segment_id": "SRR_001_90",
    "start": 829.653,
    "end": 850.245,
    "original_speaker": "SPEAKER_00",
    "verified_speaker": "Translator",
    "text": "So if you put this into practice then, this particular instruction, have engaged diligently, will cause you then to gain realization of the definitive secret which is likened here to space.",
    "include_in_corpus": null,
    "exclusion_reason": null
  },
  {
    "segment_id": "SRR_001_91",
    "start": 852.766,
    "end": 853.807,
    "original_speaker": "SPEAKER_01",
    "verified_speaker": "Rinpochoe",
