    "start": 716.712,
    "end": 719.393,
    "original_speaker": "SPEAKER_01",
    "verified_speaker": "Rinpochoe",
    "text": "Gompa means meditation.",
    "include_in_corpus": null,
    "exclusion_reason": null
  },
  {
    "segment_id": "SRR_001_78",
    "start": 720.754,
    "end": 725.097,
    "original_speaker": "SPEAKER_01",
    "verified_speaker": "Rinpochoe",
    "text": "So always Khen Rinpoche recommends here also like that.",
