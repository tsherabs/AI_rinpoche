    "start": 618.328,
    "end": 630.892,
    "original_speaker": "SPEAKER_01",
    "verified_speaker": "Rinpochoe",
    "text": "meditate on impermanent, have a renunciation, and especially the conduct, law of the conduct, law of the karma, effort.",
    "include_in_corpus": null,
