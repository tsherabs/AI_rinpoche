    "segment_id": "SRR_001_105",
    "start": 937.569,
    "end": 939.95,
    "original_speaker": "SPEAKER_02",
    "verified_speaker": "unknown",
    "text": "Should it be dealt with the same as a thought or is it different?",
    "include_in_corpus": null,
    "exclusion_reason": null
  },
  {
    "segment_id": "SRR_001_106",
    "start": 946.613,
