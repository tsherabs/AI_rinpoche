    "end": 637.254,
    "original_speaker": "SPEAKER_01",
    "verified_speaker": "Rinpochoe",
    "text": "If you are an ordained monk or nun, then very strictly follow the Vinaya, law and conduct.",
    "include_in_corpus": null,
    "exclusion_reason": null
  },
