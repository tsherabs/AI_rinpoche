  },
  {
    "segment_id": "SRR_001_103",
    "start": 931.746,
    "end": 932.026,
    "original_speaker": "SPEAKER_02",
    "verified_speaker": "unknown",
    "text": "Sorry?",
    "include_in_corpus": null,
    "exclusion_reason": null
  },
  {
    "segment_id": "SRR_001_104",
    "start": 933.046,
    "end": 937.469,
    "original_speaker": "SPEAKER_02",
    "verified_speaker": "unknown",
    "text": "Is the strong emotion and this body sensation the same as a thought?",
    "include_in_corpus": null,
    "exclusion_reason": null
  },
