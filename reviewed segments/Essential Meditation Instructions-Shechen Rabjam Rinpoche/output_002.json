    "exclusion_reason": null
  },
  {
    "segment_id": "SRR_001_88",
    "start": 809.693,
    "end": 815.957,
    "original_speaker": "SPEAKER_00",
    "verified_speaker": "Translator",
    "text": "So here then, this is described as the kind of quintessence of the Dharma, the essential pit instructions.",
    "include_in_corpus": null,
    "exclusion_reason": null
  },
  {
    "segment_id": "SRR_001_89",
    "start": 817.878,
    "end": 824.803,
    "original_speaker": "SPEAKER_01",
    "verified_speaker": "Rinpochoe",
