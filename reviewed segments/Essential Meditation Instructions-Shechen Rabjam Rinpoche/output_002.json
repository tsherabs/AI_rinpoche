    "segment_id": "SRR_001_101",
    "start": 916.772,
    "end": 922.534,
    "original_speaker": "SPEAKER_02",
    "verified_speaker": "unknown",
    "text": "Do you have any advice on how to apply this practice to strong emotions?",
    "include_in_corpus": null,
    "exclusion_reason": null
  },
