    "end": 539.15,
    "original_speaker": "SPEAKER_00",
    "verified_speaker": "Rinpochoe",
    "text": "And mother felt a little bit embarrassed because it sounds a little bit rude, you know?",
    "include_in_corpus": null,
    "exclusion_reason": null
  },
