    "text": "It's so wonderful to see you back here in North America.",
    "include_in_corpus": null,
    "exclusion_reason": null
  },
  {
    "segment_id": "SRR_001_2",
    "start": 20.724,
    "end": 21.824,
    "original_speaker": "SPEAKER_00",
    "verified_speaker": "Organizer",
    "text": "Very nice to see you.",
    "include_in_corpus": null,
    "exclusion_reason": null
