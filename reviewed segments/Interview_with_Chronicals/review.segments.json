    "end": 31.591,
    "original_speaker": "SPEAKER_00",
    "verified_speaker": "Organizer",
    "text": "The return of Khyentse Rinpoche to the West is a great event for all of Chögyam Trungpa Rinpoche's students",
    "include_in_corpus": null,
    "exclusion_reason": null
  },
  {
