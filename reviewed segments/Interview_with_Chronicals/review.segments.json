    "end": 15.84,
    "original_speaker": "SPEAKER_00",
    "verified_speaker": "Organizer",
    "text": "Rinpoche, thank you so much for seeing us this morning and on behalf of the Chronicles of Chögyam Trungpa Rinpoche and all of his students, we're so pleased that you have some time to talk with us today.",
    "include_in_corpus": null,
    "exclusion_reason": null
