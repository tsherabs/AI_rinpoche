    "start": 149.12,
    "end": 156.485,
    "original_speaker": "SPEAKER_01",
    "verified_speaker": "Rinpochoe",
    "text": "Of course, the previous Khyentse Rinpoche and the young Khyentse Rinpoche, the physical appearance is different.",
    "include_in_corpus": null,
    "exclusion_reason": null
  },
  {
    "segment_id": "SRR_001_17",
    "start": 158.086,
    "end": 160.608,
    "original_speaker": "SPEAKER_01",
    "verified_speaker": "Rinpochoe",
    "text": "Like himself says that I am much smaller and all that.",
    "include_in_corpus": null,
    "exclusion_reason": null
  },
