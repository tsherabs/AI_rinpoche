    "start": 32.47,
    "end": 38.151,
    "original_speaker": "SPEAKER_00",
    "verified_speaker": "Organizer",
    "text": "And we wondered if you would say something about the significance of this visit for our viewers.",
    "include_in_corpus": null,
    "exclusion_reason": null
  },
