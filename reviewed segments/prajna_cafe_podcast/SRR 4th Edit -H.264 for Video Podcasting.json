    "end": 19.63,
    "original_speaker": "SPEAKER_00",
    "verified_speaker": "Interviewer",
    "text": "This is a haven of discussion in the form of a podcast where we share our ideas on Buddhism in the modern world with fellow Buddhist practitioners.",
    "include_in_corpus": null,
    "exclusion_reason": null
  },
  {
    "segment_id": "SRR_001_2",
    "start": 20.797,
    "end": 28.039,
    "original_speaker": "SPEAKER_00",
    "verified_speaker": "Interviewer",
    "text": "I'm your host, Orguyen, and today we're welcoming our first special guest, who many of you met just a few weeks ago in L'Arabli.",
    "include_in_corpus": null,
    "exclusion_reason": null
  },
  {
