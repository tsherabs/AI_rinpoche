    "original_speaker": "SPEAKER_00",
    "verified_speaker": "Interviewer",
    "text": "Welcome to Prajna Cafe, a space where East meets West and we discuss on the challenges of authentic spiritual traditions in the modern world.",
    "include_in_corpus": null,
